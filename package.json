{
  "name": "this-sunday",
  "version": "0.1.0",
  "private": true,
  "description": "One page for the coming Sunday: readings, the Gospel explained, a reflection and a question for the family.",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsx scripts/check-content.ts",
    "build": "tsc --noEmit && tsx scripts/build.ts",
    "build:fast": "tsx scripts/build.ts --skip-og",
    "preview": "vite preview --outDir dist --port 4173",
    "preview:all": "PREVIEW_ALL=1 tsx scripts/build.ts && vite preview --outDir dist --port 4173",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@fontsource-variable/anek-malayalam": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/noto-sans-syriac-western": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "feed": "^6.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}